const DEFAULT_CONFIG = {
  axis: 'z',
  forward: -1,
  height: 0.62,
  fromFront: 0.5,
  lateral: 0,
  lookAhead: 0.18
};

export function createCockpitCamera({ THREE, camera, controls }) {
  if (!THREE || !camera || !controls) {
    throw new Error(
      'Cockpit camera requires THREE, camera, and OrbitControls.'
    );
  }

  const cameraPosition = new THREE.Vector3();
  const lookTarget = new THREE.Vector3();
  const center = new THREE.Vector3();
  const size = new THREE.Vector3();

  function enter(vehicle, vehicleId) {
    if (!vehicle) {
      console.warn('Cockpit camera: no vehicle is loaded.');
      return false;
    }

    const config =
      VEHICLE_COCKPIT_CONFIG[vehicleId] || DEFAULT_CONFIG;

    vehicle.updateMatrixWorld(true);

    const bounds = new THREE.Box3().setFromObject(vehicle);

    if (bounds.isEmpty()) {
      console.warn('Cockpit camera: vehicle bounds are empty.');
      return false;
    }

    bounds.getCenter(center);
    bounds.getSize(size);

    const longitudinalLength = Math.max(
      size[config.axis],
      0.1
    );

    const verticalHeight = Math.max(size.y, 0.1);
    const lateralAxis = config.axis === 'x' ? 'z' : 'x';
    const lateralWidth = Math.max(size[lateralAxis], 0.1);

    const frontCoordinate =
      center[config.axis] +
      config.forward * longitudinalLength * 0.5;

    const longitudinalPosition =
      frontCoordinate -
      config.forward *
        longitudinalLength *
        config.fromFront;

    const verticalPosition =
      bounds.min.y + verticalHeight * config.height;

    const lateralPosition =
      center[lateralAxis] +
      lateralWidth * config.lateral;

    cameraPosition.copy(center);
    cameraPosition[config.axis] = longitudinalPosition;
    cameraPosition.y = verticalPosition;
    cameraPosition[lateralAxis] = lateralPosition;

    lookTarget.copy(cameraPosition);
    lookTarget[config.axis] +=
      config.forward *
      longitudinalLength *
      config.lookAhead;

    controls.autoRotate = false;
    controls.minDistance = 0.05;
    controls.maxDistance = Math.max(8, longitudinalLength * 1.5);
    controls.target.copy(lookTarget);

    camera.position.copy(cameraPosition);
    camera.lookAt(lookTarget);

    controls.update();

    console.info('MorphDrive: cockpit camera entered.', {
      vehicleId,
      axis: config.axis,
      forward: config.forward,
      cameraPosition: cameraPosition.toArray(),
      lookTarget: lookTarget.toArray()
    });

    return true;
  }

  return {
    enter,
    getSupportedVehicles() {
      return Object.keys(VEHICLE_COCKPIT_CONFIG);
    }
  };
}
